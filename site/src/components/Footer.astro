---
// Starlight's footer plus a support link. A plain link, not Ko-fi's widget script: the site loads
// no third-party JavaScript.
import Default from "@astrojs/starlight/components/Footer.astro";
---

<Default {...Astro.props}><slot /></Default>
<p class="maker">
  <a href="https://github.com/codizelabs" aria-label="A Codize Labs project">
    <span>A project by</span>
    <img class="on-light" src={`${import.meta.env.BASE_URL}images/codizelabs-logo.png`} alt="Codize Labs" width="140" height="42" loading="lazy" />
    <img class="on-dark" src={`${import.meta.env.BASE_URL}images/codizelabs-logo-reversed.png`} alt="Codize Labs" width="140" height="42" loading="lazy" />
  </a>
</p>
<p class="support">
  <a href="https://ko-fi.com/R5R31N7TP" rel="noopener">
    <span aria-hidden="true">☕</span> Support Agent Rewake on Ko-fi
  </a>
</p>

<style>
  .maker {
    margin: 2rem 0 0;
    text-align: center;
  }
  .maker a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .maker img {
    width: 140px;
    height: auto;
  }
  :global([data-theme="dark"]) .maker .on-light,
  :global([data-theme="light"]) .maker .on-dark {
    display: none;
  }
  .support {
    margin: 2rem 0 0.5rem;
    text-align: center;
  }
  .support a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    /* Ko-fi blue; dark text gives 6.9:1 contrast (WCAG AA needs 4.5:1; white text would be 2.5:1). */
    background: #72a4f2;
    color: #0b1a33;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .support a span {
    margin-inline-end: 0.4em;
  }
  .support a:hover,
  .support a:focus-visible {
    background: #8db6f5;
  }
  .support a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
</style>
