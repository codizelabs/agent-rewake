/**
 * "How it works": one diagram per way Rewake gets in. Each label is what the code does there:
 * src/acp (Zed), src/hosts/claude-code (a plugin in the session), src/hosts + src/timers (hooks,
 * then a one-shot system timer that runs `agent-rewake fire`). Drawn twice: across on wide
 * screens, down on narrow ones, so the text stays readable.
 */
type FlowNode = { title: string; lines: string[]; rw?: boolean };
const flows: Array<{ id: string; heading: string; text: string; label: string; back: boolean; nodes: FlowNode[] }> = [
  {
    id: "inside",
    heading: "Inside Claude Code (preview)",
    text: "Rewake's plugin runs inside the Claude Code session. It sees the limit, asks once, and continues the same session after the reset. When Claude Code's own continue will do that, the plugin leaves it to Claude Code. Keep Claude Code open.",
    label: "Claude Code stops at its usage limit; Rewake's plugin, inside the session, asks once and waits; the same session continues after the reset.",
    back: false,
    nodes: [
      { title: "Claude Code", lines: ["stops at the usage limit"] },
      { title: "Rewake's plugin", lines: ["inside the session", "asks once, then waits"], rw: true },
      { title: "Same session", lines: ["continues after the reset"] },
    ],
  },
  {
    id: "timer",
    heading: "Codex and the closed-session previews",
    text: "The agent's own hooks tell Rewake about the limit. When you agree, the system's own timer runs Rewake once at the reset, and it continues the same session: through Codex's own queue (if Codex is closed then, when you next open it), or with the agent's own resume command once the session is closed. No Rewake process waits in between. Keep the computer on and awake.",
    label: "The agent's hooks record the limit; a system timer (launchd, systemd or at, Task Scheduler) runs Rewake once at the reset; the same session continues.",
    back: false,
    nodes: [
      { title: "The agent's hooks", lines: ["Codex · Copilot CLI · Gemini CLI", "Grok Build · Qwen Code · Antigravity CLI", "OpenCode (its plugin)"] },
      { title: "Your computer's timer", lines: ["launchd · systemd or at", "Task Scheduler"], rw: true },
      { title: "Rewake, once", lines: ["at the reset:", "continues the same session"] },
    ],
  },
  {
    id: "zed",
    heading: "In Zed's Agent Panel",
    text: "Zed talks to coding agents over the Agent Client Protocol (ACP). Zed starts Rewake as the agent, Rewake starts the real agent, and everything else passes through unchanged. Keep Zed open.",
    label: "Zed connects to Agent Rewake, which connects to your agent (Claude, Codex, Gemini and others). Messages pass through in both directions.",
    back: true,
    nodes: [
      { title: "Zed", lines: ["your threads, unchanged"] },
      { title: "Agent Rewake", lines: ["menu · schedules · limits", "runs on your computer"], rw: true },
      { title: "Your agent", lines: ["Claude · Codex · Gemini…"] },
    ],
  },
];
const NODE_W = 216;
const NODE_H = 120;
const GAP_X = 140;
const V_W = 300;
const GAP_Y = 64;
/** Node i's box, across (wide) or down (narrow). */
const box = (i: number, down: boolean) =>
  down ? { x: 30, y: 2 + i * (NODE_H + GAP_Y), w: V_W } : { x: 16 + i * (NODE_W + GAP_X), y: 25, w: NODE_W };
/** The wires between the boxes. */
const wires = (down: boolean) =>
  [0, 1].map((i) => {
    const a = box(i, down);
    const b = box(i + 1, down);
    return down ? `M180 ${a.y + NODE_H} V${b.y}` : `M${a.x + a.w} 85 H${b.x}`;
  });
const V_H = 4 + 3 * NODE_H + 2 * GAP_Y;

const words ="When your agent hits its limit, Rewake picks the thread back up.".split(" ");
