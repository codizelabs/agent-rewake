const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const site = new URL(base, Astro.site);
const href = (path = "") => `${base}${path}`;
const title = "Agent Rewake: auto-resume Claude Code, Codex and other coding agents after a usage limit";
const description =
  "Free, open-source add-on: when Claude Code, Codex, Gemini or another coding agent hits its usage limit, the same session picks the work back up when the limit resets. In a terminal, in Claude Code's VS Code and Cursor panel, and in Zed's Agent Panel for every external agent; everything outside Zed is a preview.";
const image = new URL("social-preview.png", site).href;
const updated = "2026-10-08";

const faq: Array<{ q: string; a: string[] }> = [
  {
    q: "What happens when Claude hits its usage limit in Zed?",
    a: [
      "Claude stops with a message such as \"You've hit your session limit · resets 5pm\", and the thread waits until you come back and type something. With Agent Rewake, the thread asks once whether to resume when the limit resets, with your resume message ready to edit, and sends it as soon as the limit resets.",
    ],
  },
  {
    q: "What happens at a usage limit in Claude Code, Codex or another terminal agent?",
    a: [
      "With its preview installed: Claude Code asks once whether to continue the session after the reset, then continues it; when Claude Code's own continue will do that, Rewake leaves it to Claude Code. In Codex, type `rewake` in the thread at the limit (in Claude Code and Gemini CLI, `/rewake`), and the thread continues after the reset. GitHub Copilot CLI, Gemini CLI, Grok Build, Qwen Code, OpenCode and Antigravity CLI sessions are continued once they're closed: run `npx @codizelabs/agent-rewake continue` before the reset.",
    ],
  },
  {
    q: "Can it resume automatically, without asking?",
    a: [
      "Yes, if you turn it on. In Zed: per thread from the Rewake menu (Turn on auto-resume after limits…), or for new threads in Rewake → Settings…. In Claude Code, answer that it should continue from then on; for closed Claude Code, Copilot CLI, Gemini CLI, Grok Build, Qwen Code, OpenCode and Antigravity CLI sessions, run `npx @codizelabs/agent-rewake continue --always` once. It still asks instead when the reset is more than 24 hours away; in Zed also when the agent gives the same reset time twice, or when you chose to exclude threads that bypass permissions.",
    ],
  },
  {
    q: "Does it work with Codex, Gemini CLI and other agents?",
    a: [
      "Yes. Rewake goes in front of every external agent Zed runs and works the same way with each: the menu, scheduling, the schedules page and resume after a limit. Claude and Codex say when the limit resets; for agents that don't (Gemini CLI, for example), you pick when to resume. Outside Zed, previews cover Codex, Gemini CLI, GitHub Copilot CLI, Grok Build, Qwen Code, OpenCode and Antigravity CLI in a terminal.",
    ],
  },
  {
    q: "Does Zed, or anything else, need to stay open?",
    a: [
      "In Zed, yes: Rewake runs inside Zed, so nothing is sent while Zed is closed or the computer is asleep. You don't need the thread on screen: you can work in other threads. After restarting Zed, open the thread once. A message more than 15 minutes late isn't sent on its own: Rewake asks you.",
      "In Claude Code, keep Claude Code open: Rewake's plugin runs inside it, and a continue that came due while it was closed is offered when you reopen the session. For Codex, GitHub Copilot CLI, Gemini CLI, Grok Build, Qwen Code, OpenCode and Antigravity CLI, nothing needs to stay open: the system's own timer starts Rewake at the reset. Keep the computer on and awake; if Codex is closed then, the thread continues when you next open it.",
    ],
  },
  {
    q: "Claude Code can continue by itself now. What's left for Rewake?",
    a: [
      "In Claude Code, less than you might think, and Rewake steps aside there: when Claude Code's own \"Continue automatically at usage limit\" will most likely do it (its setting on, a reset within a day), Rewake leaves the limit to it. It asks to continue when that won't apply: in Claude Code's VS Code and Cursor panel, where that setting doesn't apply, or when the setting is off or the reset is further away.",
      "What's left is everything outside that one case. Claude Code's own continue works in its own terminal sessions and only for Claude; whether it applies to the Claude adapter that Zed runs isn't documented. Rewake covers Codex, GitHub Copilot CLI, Gemini CLI, Grok Build, Qwen Code, OpenCode, Antigravity CLI and every external agent in Zed, from one command and one schedules page, and it sends messages later: once, repeating, or one after another after a resume. Checked 2026-10-08.",
    ],
  },
  {
    q: "Does Rewake get around usage limits?",
    a: [
      "No. It waits for the reset the agent reports, or the time you pick, then sends one message, as you would. That message uses your plan like any message you type. Your plan, limits and credits don't change, and a credit, billing or spending limit, which waiting won't fix, gets a message and no resume.",
    ],
  },
  {
    q: "What if the reset time is wrong, or the agent is still limited?",
    a: [
      "Rewake follows the agent: if it's still limited when Rewake continues, it waits for the new reset time. A reset more than a day away is confirmed with you first, even when automatic resume is on. For agents that don't say when their limit resets (Copilot CLI's weekly limit, Grok's free limit, Cursor), you choose the time.",
    ],
  },
  {
    q: "What if my computer is asleep at the reset?",
    a: [
      "Nothing is sent while it sleeps. When it wakes, a resume more than half an hour late (15 minutes in Zed) isn't sent on its own: Rewake asks or tells you instead. On macOS (and, not yet tried by hand, Linux with systemd and Windows), Rewake keeps the computer from idling to sleep while a resume is due within six hours (while plugged in, by default); closing the lid still puts it to sleep. `agent-rewake doctor` says if your own sleep settings would let it sleep, and the docs list [the settings to change](@docs/#keep-your-computer-awake).",
    ],
  },
  {
    q: "How do I know it worked?",
    a: [
      "Run `npx @codizelabs/agent-rewake doctor`: it lists the continues planned for closed sessions, any that need you, and the last error if one failed. In Zed, the schedules page lists every message and its state, and a message Rewake sends is labelled as coming from Rewake, so you can tell it from one you typed.",
    ],
  },
  {
    q: "Rewake missed my usage limit. What do I send you?",
    a: [
      "Open a bug report with the agent and its version, the exact limit message as the agent printed it (private details removed), what you expected, and the output of `npx @codizelabs/agent-rewake doctor --details`. [How to report a limit Rewake missed](@docs/#report-a-limit-rewake-missed).",
    ],
  },
  {
    q: "Can my agent schedule its own follow-ups?",
    a: [
      "Yes, but only with your approval. The agent gets tools to schedule, change and cancel messages in its own thread; each request shows a form in the thread, where you can edit the message and accept or decline. It can also read Rewake's guide to answer your questions about Rewake.",
    ],
  },
  {
    q: "Does it change my plan or send my data anywhere?",
    a: [
      "Rewake sends one message, which uses your plan like any message you type; it doesn't change your plan, limits or credits, and it never approves permission prompts for you. Everything stays on your computer; it sends nothing about you anywhere (its only network use is fetching an agent's own program when Zed hasn't) and sends only the messages you scheduled, to your agent. Logs hold metadata, never message text. [What it runs, stores and changes](@docs/privacy-and-security/), and how to undo it.",
    ],
  },
  {
    q: "Does it work with Claude Code in a terminal, in VS Code or Cursor, the Claude desktop app, or Zed's own agent?",
    a: [
      "Claude Code in a terminal, and in its panel in VS Code or Cursor: yes, as a preview. Pick it in `npx @codizelabs/agent-rewake install`, or run `npx @codizelabs/agent-rewake install --only claude-code`. The Claude desktop app's Code tab hasn't been tried yet. Claude's own apps (claude.ai and the desktop app's chat) and Zed's own agent can't be reached: Zed doesn't let add-ons into its own agent. Claude Code and the desktop app also each have their own setting to continue after a usage limit.",
    ],
  },
  {
    q: "How do I update it?",
    a: [
      "From any version: run `npx @codizelabs/agent-rewake@latest install`, then quit Zed completely and open it again. The previews outside Zed use the new version from their next session. Your threads, scheduled messages and settings stay. Any version-specific steps (none so far) are in the docs.",
    ],
  },
  {
    q: "Is it a Zed extension?",
    a: [
      "No. Zed extensions can't add this, so in Zed, Rewake is an add-on on the Agent Client Protocol (ACP) connection between Zed and your agent. Outside Zed, it uses each agent's own plugins, extensions or hooks. `agent-rewake install` sets it up in the places you pick, and `agent-rewake uninstall` takes it out.",
    ],
  },
];

/** An answer's `code` and [links](@path): "@" stands for the site's base path. */
const answerHtml = (p: string) =>
  p
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\[([^\]]+)\]\(@([^)]*)\)/g, (_m, text: string, path: string) => `<a href="${href(path)}">${text}</a>`);

