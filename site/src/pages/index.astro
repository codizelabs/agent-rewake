const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const site = new URL(base, Astro.site);
const href = (path = "") => `${base}${path}`;
const title = "Agent Rewake: auto-resume Claude Code, Codex and other coding agents after a usage limit";
const description =
  "Free, open-source add-on: when Claude, Codex, Gemini or another coding agent hits its usage limit, the work picks back up on its own when the limit resets. In Zed's Agent Panel for every external agent, and as previews for Claude Code, Codex, Copilot CLI, Gemini CLI, Grok Build and Antigravity CLI in the terminal.";
const image = new URL("social-preview.png", site).href;
const updated = "2026-10-06";

const faq: Array<{ q: string; a: string[] }> = [
  {
    q: "What happens when Claude hits its usage limit in Zed?",
    a: [
      "Claude stops with a message such as \"You've hit your session limit · resets 5pm\", and the thread waits until you come back and type something. With Agent Rewake, the thread asks once whether to resume when the limit resets, with your resume message ready to edit, and sends it as soon as the limit resets.",
    ],
  },
  {
    q: "What happens at a usage limit in Claude Code, Codex or another terminal agent?",
    a: [
      "With its preview installed: Claude Code asks once whether to continue the session after the reset, then continues it; when Claude Code's own continue will do that, Rewake leaves it to Claude Code. In Codex, type `rewake` in the thread at the limit, and the thread continues after the reset. GitHub Copilot CLI, Gemini CLI, Grok Build and Antigravity CLI sessions are continued once they're closed: run `npx @codizelabs/agent-rewake continue` before the reset.",
    ],
  },
  {
    q: "Can it resume automatically, without asking?",
    a: [
      "Yes, if you turn it on. In Zed: per thread from the Rewake menu (Turn on auto-resume after limits…), or for new threads in Rewake → Settings…. In Claude Code, answer that it should continue from then on; for closed Copilot CLI, Gemini CLI, Grok Build and Antigravity CLI sessions, run `npx @codizelabs/agent-rewake continue --always` once. It still asks instead when the reset is more than 24 hours away; in Zed also when the agent gives the same reset time twice, or when you chose to exclude threads that bypass permissions.",
    ],
  },
  {
    q: "Does it work with Codex, Gemini CLI and other agents?",
    a: [
      "Yes. Rewake goes in front of every external agent Zed runs and works the same way with each: the menu, scheduling, the schedules page and resume after a limit. Claude and Codex say when the limit resets; for agents that don't (Gemini CLI, for example), you pick when to resume. Outside Zed, previews cover Codex, Gemini CLI, GitHub Copilot CLI, Grok Build and Antigravity CLI in a terminal.",
    ],
  },
  {
    q: "Does Zed, or anything else, need to stay open?",
    a: [
      "In Zed, yes: Rewake runs inside Zed, so nothing is sent while Zed is closed or the computer is asleep. You don't need the thread on screen: you can work in other threads. After restarting Zed, open the thread once. A message more than 15 minutes late isn't sent on its own: Rewake asks you.",
      "In Claude Code, keep Claude Code open: Rewake's plugin runs inside it, and a continue that came due while it was closed is offered when you reopen the session. For Codex, GitHub Copilot CLI, Gemini CLI, Grok Build and Antigravity CLI, nothing needs to stay open: the system's own timer starts Rewake at the reset. Keep the computer on and awake; if Codex is closed then, the thread continues when you next open it.",
    ],
  },
  {
    q: "How is this different from Claude Code's own auto-continue?",
    a: [
      "Claude Code's auto-continue works in its own terminal sessions and only for Claude; whether it applies to the Claude adapter that Zed runs isn't documented. In Zed, Rewake works in the thread you already have, for every agent, and also schedules messages: once, repeating, or one after another after a resume. In Claude Code itself, Rewake's preview leaves a limit to Claude Code's own continue when that will most likely apply (its setting on, a reset within a day), and asks to continue when it won't.",
    ],
  },
  {
    q: "Can my agent schedule its own follow-ups?",
    a: [
      "Yes, but only with your approval. The agent gets tools to schedule, change and cancel messages in its own thread; each request shows a form in the thread, where you can edit the message and accept or decline. It can also read Rewake's guide to answer your questions about Rewake.",
    ],
  },
  {
    q: "Does it spend usage credits or send my data anywhere?",
    a: [
      "No. Rewake doesn't change your plan, limits or credits, and it never approves permission prompts for you. Everything stays on your computer; it sends only the messages you scheduled, to your agent. Logs hold metadata, never message text.",
    ],
  },
  {
    q: "Does it work with Claude Code in a terminal, the Claude desktop app, or Zed's own agent?",
    a: [
      "Claude Code in a terminal: yes, as a preview. Pick it in `npx @codizelabs/agent-rewake install`, or run `npx @codizelabs/agent-rewake install --only claude-code`. The Claude desktop app's Code tab isn't supported yet. Claude's own apps (claude.ai and the desktop app's chat) and Zed's own agent can't be reached: Zed doesn't let add-ons into its own agent. Claude Code and the desktop app also each have their own setting to continue after a usage limit.",
    ],
  },
  {
    q: "How do I update it?",
    a: [
      "From any version: run `npx @codizelabs/agent-rewake@latest install`, then quit Zed completely and open it again. The previews outside Zed use the new version from their next session. Your threads, scheduled messages and settings stay. Any version-specific steps (none so far) are in the docs.",
    ],
  },
  {
    q: "Is it a Zed extension?",
    a: [
      "No. Zed extensions can't add this, so in Zed, Rewake is an add-on on the Agent Client Protocol (ACP) connection between Zed and your agent. Outside Zed, it uses each agent's own plugins, extensions or hooks. `agent-rewake install` sets it up in the places you pick, and `agent-rewake uninstall` takes it out.",
    ],
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Agent Rewake",
    description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Linux, Windows",
