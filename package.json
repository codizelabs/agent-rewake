{
  "name": "@codizelabs/agent-rewake",
  "version": "0.3.1",
  "description": "Auto-resume Claude Code, Codex, Gemini CLI, GitHub Copilot, Grok or any Zed agent when its usage limit resets, in the same session, and schedule messages into your agent threads.",
  "keywords": [
    "zed",
    "zed-editor",
    "acp",
    "agent-client-protocol",
    "claude",
    "claude-code",
    "codex",
    "gemini-cli",
    "github-copilot",
    "copilot-cli",
    "grok",
    "antigravity",
    "ai-agents",
    "coding-agent",
    "claude-code-auto-resume",
    "session-limit",
    "weekly-limit",
    "usage-limit",
    "rate-limit",
    "auto-resume",
    "resume",
    "schedule",
    "scheduler",
    "cron"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codizelabs/agent-rewake.git"
  },
  "homepage": "https://rewake.js.org/",
  "bugs": {
    "url": "https://github.com/codizelabs/agent-rewake/issues"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/R5R31N7TP"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-rewake": "dist/agent-rewake.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.85.1"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "author": "KASHAN HAIDER (https://github.com/SMKH-PRO)"
}
